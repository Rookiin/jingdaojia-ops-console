/**
 * 适老设计变量与通用样式：大字号、大按钮、高对比、每屏一个主操作。
 */
page {
  --c-primary: #0f766e;
  --c-primary-dark: #115e59;
  --c-text: #111827;
  --c-muted: #4b5563;
  --c-bg: #f4f5f7;
  --c-surface: #ffffff;
  --c-border: #dfe3e8;
  --c-warn: #b45309;
  --c-danger: #b91c1c;
  --c-success: #15803d;

  background: var(--c-bg);
  color: var(--c-text);
  font-size: 34rpx;
  line-height: 1.6;
}

.screen {
  padding: 24rpx 28rpx 60rpx;
}

.card {
  background: var(--c-surface);
  border: 1rpx solid var(--c-border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.big-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.4;
}

.muted {
  color: var(--c-muted);
  font-size: 30rpx;
}

.strong {
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: var(--c-border);
  margin: 24rpx 0;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--c-primary);
  color: #ffffff;
}

.btn-primary:active {
  background: var(--c-primary-dark);
}

.btn-secondary {
  background: #ffffff;
  color: var(--c-primary);
  border: 2rpx solid var(--c-primary);
}

.btn-secondary:active {
  background: #ecfdf5;
}

.btn-block {
  width: 100%;
}

.btn-disabled,
.btn[disabled] {
  background: #d1d5db;
  color: #6b7280;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tag-assigned {
  background: #fef3c7;
  color: var(--c-warn);
}

.tag-checked_in {
  background: #dbeafe;
  color: #1d4ed8;
}

.tag-completed {
  background: #dcfce7;
  color: var(--c-success);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
}

.row-label {
  color: var(--c-muted);
  flex: 0 0 auto;
}

.row-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.notice {
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  color: #9a3412;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.notice-safe {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #166534;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.step {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: var(--c-muted);
}

.step-num {
  display: block;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
  background: #e5e7eb;
  color: #6b7280;
  font-weight: 700;
}

.step.is-done .step-num {
  background: var(--c-success);
  color: #ffffff;
}

.step.is-active .step-num {
  background: var(--c-primary);
  color: #ffffff;
}

.step.is-active,
.step.is-done {
  color: var(--c-text);
  font-weight: 600;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--c-primary);
  color: var(--c-primary);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #ffffff;
}

.big-number {
  font-size: 64rpx;
  font-weight: 700;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--c-border);
}

.list-item:last-child {
  border-bottom: none;
}

.radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #9ca3af;
}

.radio.is-on {
  border-color: var(--c-primary);
  background: var(--c-primary);
}

.footer-gap {
  height: 40rpx;
}
